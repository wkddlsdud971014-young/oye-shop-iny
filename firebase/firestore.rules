
// 이 파일은 main 에 들어오면 GitHub Actions 가 테스트를 거쳐 배포한다 - 콘솔에서 고치지 않는다
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMine(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["staff", "admin"];
    }

    // 실습 213: 손님은 재고만 줄일 수 있다
    function onlyStockDown() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.stock >= 0;
    }

    // 실습 213: 상품 가격은 0보다 큰 숫자여야 한다
    function validPrice() {
      return request.resource.data.price is number
          && request.resource.data.price > 0;
    }

    // 상품: 직원은 생성·수정 가능, 손님은 재고 줄이기만 가능
    match /products/{productId} {
      allow read: if true;
      allow create: if isStaff() && validPrice();
      allow update: if (isStaff() && validPrice())
                    || (signedIn() && onlyStockDown());
      allow delete: if false;
    }

    // 주문: 본인 또는 직원만 조회, 본인 주문만 생성
    match /orders/{orderId} {
      allow read: if isMine(resource.data.userId) || isStaff();
      allow create: if isMine(request.resource.data.userId);
      allow update: if isStaff();
    }

    // 사용자: 본인 정보만 조회
    match /users/{userId} {
      allow read: if isMine(userId);
    }

    // 알림 받는 주소 - 문서 ID가 내 UID일 때만 읽고 쓴다
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 관리자 활동 로그: 직원만 읽고, 브라우저에서는 수정 금지
    match /adminLogs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // 그 밖의 모든 문서는 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
